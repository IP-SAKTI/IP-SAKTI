# =============================================================================
# IP-SAKTI Sahayak — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM Provider (Gemini) ────────────────────────────────────────────────────
# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model name to use for answer generation
# Example: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | text
LOG_FORMAT=json

# ── Paths (override defaults from config/settings.yaml) ──────────────────────
# Directory for FAISS and BM25 index files (must NOT be committed)
INDEX_DIR=indexes/

# Directory for SQLite database file (must NOT be committed)
DB_DIR=db/

# Directory for curated knowledge base source documents (must NOT be committed)
DATA_DIR=data/

# SQLite database file name (created inside DB_DIR)
DB_NAME=ip_sakti.db

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of candidates to retrieve from FAISS before RRF
FAISS_TOP_K=20

# Number of candidates to retrieve from BM25 before RRF
BM25_TOP_K=20

# Final number of evidence chunks after cross-encoder reranking
RERANK_TOP_K=5

# ── Safety ────────────────────────────────────────────────────────────────────
# Minimum confidence score (0.0–1.0) below which safe abstention is triggered
CONFIDENCE_THRESHOLD=0.5

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit UI ──────────────────────────────────────────────────────────────
# Internal URL of the FastAPI backend (used by the Streamlit app)
API_BASE_URL=http://localhost:8000
