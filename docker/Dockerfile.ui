# =============================================================================
# IP-SAKTI Sahayak — Streamlit UI Dockerfile
# Python 3.11-slim base; Streamlit listens on port 8501.
# =============================================================================

FROM python:3.11-slim AS base

ARG APP_USER=appuser
ARG APP_UID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid ${APP_UID} ${APP_USER} \
    && useradd --uid ${APP_UID} --gid ${APP_UID} --no-create-home ${APP_USER}

WORKDIR /app

# ── Install Python dependencies ───────────────────────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ── Copy application source ───────────────────────────────────────────────────
COPY ip_sakti/ ./ip_sakti/
COPY config/   ./config/

RUN mkdir -p /app/logs && chown -R ${APP_USER}:${APP_USER} /app

USER ${APP_USER}

# ── Health check ──────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# ── Entrypoint ────────────────────────────────────────────────────────────────
# Streamlit application entrypoint
EXPOSE 8501
CMD ["streamlit", "run", "ip_sakti/ui/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
