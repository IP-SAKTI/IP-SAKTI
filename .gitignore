# =============================================================================
# IP-SAKTI Sahayak — .gitignore
# =============================================================================

# ── Secrets & credentials ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

_cache/
# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
eggs/
*.egg-info/
*.egg
MANIFEST
*.so
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.tox/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.test
*.spec

# ── Type checkers & linters ───────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# ── ML model weights & caches ─────────────────────────────────────────────────
# Hugging Face cache
.cache/
~/.cache/huggingface/
hf_cache/
model_cache/
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.h5
*.pkl
*.pickle
sentence_transformers/

# ── Retrieval indexes ─────────────────────────────────────────────────────────
indexes/
*.index
*.faiss
bm25_*.pkl
faiss_*.pkl

# ── Databases ─────────────────────────────────────────────────────────────────
db/
*.db
*.sqlite
*.sqlite3

# ── Large data & generated artefacts ─────────────────────────────────────────
data/
*.csv
*.jsonl
*.parquet

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Docker ───────────────────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
